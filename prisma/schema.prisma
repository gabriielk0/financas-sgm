// Este é o arquivo de schema do Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model MonthBalance {
  id             String        @id @default(uuid())
  month          Int
  year           Int
  initialBalance Float
  finalBalance   Float         @default(0)
  isClosed       Boolean       @default(false)
  reportUrl      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]

  @@unique([month, year])
}

model Transaction {
  id           String       @id @default(uuid())
  date         DateTime
  description  String
  type         String       // "IN" ou "OUT"
  amount       Float
  status       String       @default("COMPLETED") // "PENDING" ou "COMPLETED"
  monthId      String
  monthBalance MonthBalance @relation(fields: [monthId], references: [id])
  attachments  Attachment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Attachment {
  id            String      @id @default(uuid())
  url           String
  filename      String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
