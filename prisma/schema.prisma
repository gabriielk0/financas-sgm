// Este é o arquivo de schema do Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model MonthBalance {
  id             String        @id @default(uuid())
  month          Int
  year           Int
  initialBalance Float
  finalBalance   Float         @default(0)
  isClosed       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]

  @@unique([month, year])
}

model Transaction {
  id            String       @id @default(uuid())
  date          DateTime
  description   String
  type          String       // "IN" ou "OUT"
  amount        Float
  status        String       @default("COMPLETED") // "PENDING" ou "COMPLETED"
  attachmentUrl String?      // Pode armazenar string Base64 ou URL externa
  monthId       String
  monthBalance  MonthBalance @relation(fields: [monthId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
