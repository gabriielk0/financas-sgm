// Este é o arquivo de schema do Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model MonthBalance {
  id             String        @id @default(uuid())
  month          Int
  year           Int
  initialBalance Float
  finalBalance   Float         @default(0)
  isClosed       Boolean       @default(false)
  reportUrl      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]

  @@unique([month, year])
}

model Transaction {
  id            String       @id @default(uuid())
  date          DateTime
  description   String
  type          String       // "IN" ou "OUT"
  amount        Float
  status        String       @default("COMPLETED") // "PENDING" ou "COMPLETED"
  area          String       @default("Outros")
  internalNotes String?
  monthId       String
  referenceType String?
  referenceId   String?
  monthBalance  MonthBalance @relation(fields: [monthId], references: [id])
  attachments   Attachment[]
  reembolso     Reembolso?
  pagamento_orcamento PagamentoOrcamento?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Attachment {
  id            String      @id @default(uuid())
  url           String
  filename      String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Usuario {
  id         String      @id @default(uuid())
  nome       String
  equipe     String
  email      String      @unique
  whatsapp   String
  senha      String
  status     String      @default("aguardando_aprovacao")
  perfil     String      @default("equipe")
  criado_em       DateTime    @default(now())
  reembolsos      Reembolso[]
  pagamentos_orcamento PagamentoOrcamento[]
  historico_acoes ReembolsoHistory[]
  historico_pagamentos PagamentoOrcamentoHistory[]

  @@map("usuarios")
}

model Reembolso {
  id              String       @id @default(uuid())
  usuario_id      String
  nome_pagador    String
  equipe          String
  descricao       String
  finalidade      String
  valor           Float
  chave_pix       String
  anexo_url       String
  valor_aprovado  Float?
  status          String       @default("pendente_reembolso")
  motivo_rejeicao String?
  lancamento_id   String?      @unique
  criado_em       DateTime     @default(now())
  atualizado_em   DateTime     @updatedAt
  usuario         Usuario      @relation(fields: [usuario_id], references: [id])
  lancamento      Transaction? @relation(fields: [lancamento_id], references: [id])
  historico       ReembolsoHistory[]

  @@map("reembolsos")
}

model ReembolsoHistory {
  id              String    @id @default(uuid())
  reembolso_id    String
  usuario_id      String?
  acao            String    // "CRIADO", "EM_ANALISE", "APROVADO", "REJEITADO", "PAGO", "EDICAO"
  descricao       String
  criado_em       DateTime  @default(now())
  
  reembolso       Reembolso @relation(fields: [reembolso_id], references: [id], onDelete: Cascade)
  usuario         Usuario?  @relation(fields: [usuario_id], references: [id])

  @@map("reembolso_history")
}

model PagamentoOrcamento {
  id                  String       @id @default(uuid())
  usuario_id          String
  descricao           String
  finalidade          String
  fornecedor          String
  valor_total         Float
  equipe              String
  data_vencimento     DateTime
  observacoes         String?
  anexo_orcamento_url String
  anexo_nf_url        String?
  numero_nf           String?
  data_emissao_nf     DateTime?
  valor_aprovado      Float?
  motivo_rejeicao     String?
  status              String       @default("pendente_aprovacao")
  lancamento_id       String?      @unique
  criado_em           DateTime     @default(now())
  atualizado_em       DateTime     @updatedAt

  usuario             Usuario      @relation(fields: [usuario_id], references: [id])
  lancamento          Transaction? @relation(fields: [lancamento_id], references: [id])
  historico           PagamentoOrcamentoHistory[]

  @@map("pagamentos_orcamento")
}

model PagamentoOrcamentoHistory {
  id              String             @id @default(uuid())
  pagamento_id    String
  usuario_id      String?
  acao            String             // "CRIADO", "APROVADO", "PAGO", "NF_ENVIADA", "CONCLUIDO"
  descricao       String
  criado_em       DateTime           @default(now())
  
  pagamento       PagamentoOrcamento @relation(fields: [pagamento_id], references: [id], onDelete: Cascade)
  usuario         Usuario?           @relation(fields: [usuario_id], references: [id])

  @@map("pagamento_orcamento_history")
}
